# Copy to .env and fill in. .env is git-ignored; never commit real keys.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash
# Optional: the models the camera side uses (these are the defaults)
GEMINI_SCAN_MODEL=gemini-3.8-flash
GEMINI_CHECK_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id
TIGER_DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
