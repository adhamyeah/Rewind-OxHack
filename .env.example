# Copy this file to .env and fill it in. .env is git-ignored: never commit real keys.
# (Keep comments on their own lines, not after a key.)
GEMINI_API_KEY=your-gemini-key
# The ElevenLabs key needs Text to Speech and Speech to Text access.
ELEVENLABS_API_KEY=your-elevenlabs-key

# Optional. Default voice is "George", a calm British voice.
# ELEVENLABS_VOICE_ID=a-voice-id
# Optional Tiger Data copy of moments and events.
# TIGER_DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
